{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Pause & Tell",
  "nameJa": "Pause & Tell｜動画解説レコーダー",
  "slug": "pause-and-tell",
  "version": "0.3.0",
  "description": "Pause a video, draw circles, arrows and lines, and record your explanation locally as one video.",
  "descriptionJa": "動画を止め、丸や矢印を描きながら声で説明。その操作を端末内で1本の動画に録画します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-pause-and-tell"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
