{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Pause & Tell",
  "nameJa": "Pause & Tell｜動画解説レコーダー",
  "slug": "pause-and-tell",
  "version": "0.1.0",
  "description": "Pause a source video while recording your spoken explanation; recording keeps running during pauses.",
  "descriptionJa": "動画の一時停止中も説明音声と完成映像を録り続ける、端末内処理の動画解説レコーダー。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-pause-and-tell"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
